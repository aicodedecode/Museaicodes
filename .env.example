# Copy this file to .env.local for local development, or set the same
# variables as Environment Variables in your Vercel project dashboard.

# Web3Forms access key for the contact form (/contact).
# The owner activates it like this:
#   1. Go to https://web3forms.com and enter aiprofit.in@gmail.com
#   2. Verify the address via the confirmation email Web3Forms sends
#   3. Copy the access key from the Web3Forms dashboard
#   4. Paste it below (locally) and add it as NEXT_PUBLIC_WEB3FORMS_KEY
#      in Vercel: Project → Settings → Environment Variables → redeploy
# If this key is empty, the contact page shows a "being set up" notice
# with a mailto fallback instead of the form.
NEXT_PUBLIC_WEB3FORMS_KEY=
